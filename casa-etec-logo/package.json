{
  "name": "casa-etec-logo",
  "version": "1.0.0",
  "private": true,
  "description": "Animação de 5s da logo Casa E-TEC feita com Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render CasaETecLogo out/casa-etec-logo.mp4",
    "render:gif": "remotion render CasaETecLogo out/casa-etec-logo.gif --codec=gif --every-nth-frame=2",
    "still": "remotion still CasaETecLogo out/frame-final.png --frame=149",
    "render:alpha": "remotion render CasaETecLogo out/casa-etec-logo-alpha.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:webm": "remotion render CasaETecLogo out/casa-etec-logo-alpha.webm --codec=vp9 --pixel-format=yuva420p --image-format=png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "^4.0.534",
    "@remotion/motion-blur": "^4.0.534",
    "@remotion/noise": "^4.0.534",
    "@remotion/paths": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "clipper-lib": "^6.4.2",
    "opentype.js": "^1.3.4",
    "typescript": "5.6.3"
  }
}
